<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NvmeDriverSwitch</RootNamespace>
    <AssemblyName>NvmeStackPilot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>NVMe Stack Pilot</AssemblyTitle>
    <Product>NVMe Stack Pilot</Product>
    <Company>Oblivionevil</Company>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Quelldateien liegen als UTF-8 ohne BOM vor; ohne das interpretiert csc sie in der Systemcodepage. -->
    <CodePage>65001</CodePage>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Keine separate .exe.config erzeugen: die App bleibt eine einzelne EXE. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
