<Window x:Class="NvmeDriverSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVMe Stack Pilot"
        Height="880" Width="1000" MinHeight="600" MinWidth="820"
        SizeToContent="Height"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <!-- Horizontal Disabled ist Pflicht: sonst misst der ScrollViewer den Inhalt mit
       unendlicher Breite und die Sternspalten der DataGrids fallen auf 0 zusammen. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
    <StackPanel Margin="18" MaxWidth="1160" HorizontalAlignment="Center">

      <!-- ============ Status ============ -->
      <Border Style="{StaticResource CardPanel}" Background="{Binding StatusBackground}"
              BorderBrush="{Binding StatusBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Rectangle Grid.Column="0" Fill="{Binding StatusBrush}" RadiusX="3" RadiusY="3" Margin="0,2,12,2" />

          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding StatusHeadline}" FontSize="21" FontWeight="SemiBold"
                       Foreground="{Binding StatusBrush}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
              <Run Text="Laufend:" Foreground="#FF9AA0A8" /><Run Text=" " /><Run Text="{Binding RuntimeModeText, Mode=OneWay}" />
              <Run Text="   ·   " Foreground="#FF5A6068" />
              <Run Text="Konfiguriert:" Foreground="#FF9AA0A8" /><Run Text=" " /><Run Text="{Binding ConfiguredModeText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,4,0,0" Text="{Binding VerdictText}" FontWeight="SemiBold"
                       Foreground="{Binding StatusBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ Neustart-Banner ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0"
              Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}"
              Visibility="{Binding RebootBannerVisibility}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Jetzt neu starten" Style="{StaticResource PrimaryButton}"
                  Command="{Binding RebootCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding RebootBannerTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                       Text="{Binding RebootBannerDetail}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ============ Ignoriert-Hinweis ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0"
              Background="{StaticResource BadBg}" BorderBrush="{StaticResource Bad}"
              Visibility="{Binding IgnoredHintVisibility}">
        <StackPanel>
          <TextBlock Text="Windows hat die Overrides ignoriert." FontWeight="SemiBold"
                     Foreground="{StaticResource Bad}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Seit dem Setzen der Werte lag bereits ein Neustart, der Zustand hat sich trotzdem nicht geändert. Für neuere 24H2-Builds ist keine bestätigte Registry-only-Aktivierung dokumentiert; Microsoft unterstützt den nativen Stack offiziell nur unter Server 2025. Der bekannte Ausweichweg ist ViVeTool mit den Feature-IDs 60786016 und 48433719 — diese App ruft ViVeTool bewusst nicht auf." />
        </StackPanel>
      </Border>

      <!-- ============ Aktionen ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeader}" Text="TREIBER UMSCHALTEN" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Nativen Treiber aktivieren" Style="{StaticResource PrimaryButton}"
                    Command="{Binding EnableNativeCommand}" MinWidth="220" />
            <Button Content="Zurück auf klassischen Treiber" Margin="10,0,0,0"
                    Command="{Binding DisableNativeCommand}" MinWidth="220" />
          </StackPanel>
          <TextBlock Style="{StaticResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap"
                     Text="Beide Aktionen zeigen vorher die exakten Registry-Operationen im Klartext. Es wird ausschließlich der bestätigte Minimalsatz geschrieben — andere Feature-Overrides bleiben unangetastet." />
        </StackPanel>
      </Border>

      <!-- ============ Vorflugpruefung ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0"
              Visibility="{Binding PreflightVisibility}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeader}" Text="VORFLUGPRÜFUNG" />
          <ItemsControl ItemsSource="{Binding PreflightIssues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource WarnBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============ Registry ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeader}" Text="FEATUREMANAGEMENT-OVERRIDES" />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding OverridesPathText}"
                     FontFamily="Consolas" Margin="2,0,0,8" />

          <DataGrid ItemsSource="{Binding Overrides}" MaxHeight="220">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RoleText}" Value="Altwert">
                    <Setter Property="Background" Value="#26D29922" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RoleText}" Value="unbekannt">
                    <Setter Property="Background" Value="#14D29922" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RoleText}" Value="fehlt">
                    <Setter Property="Background" Value="#1AF85149" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
              <DataGridTextColumn Header="Wert" Binding="{Binding Name}" Width="130"
                                  FontFamily="Consolas" />
              <DataGridTextColumn Header="Daten" Binding="{Binding Data}" Width="70" />
              <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="100" />
              <DataGridTextColumn Header="Rolle" Binding="{Binding RoleText}" Width="110" />
              <DataGridTextColumn Header="Anmerkung" Binding="{Binding Note}" Width="*" />
              <DataGridTemplateColumn Header="" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Entfernen" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.RemoveOverrideCommand,
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Separator Margin="0,12,0,10" Background="#FF34383F" />

          <TextBlock Style="{StaticResource SectionHeader}" Text="SAFEBOOT-ABSICHERUNG" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="SafeBoot\Minimal\nvmedisk"
                       FontFamily="Consolas" Margin="2,0,16,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SafeBootMinimalText}" Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="SafeBoot\Network\nvmedisk"
                       FontFamily="Consolas" Margin="2,0,16,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SafeBootNetworkText}" Margin="0,0,0,4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Klassen-GUID {75416E63-...}"
                       FontFamily="Consolas" Margin="2,0,16,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SafeBootClassGuidText}"
                       Style="{StaticResource Muted}" TextWrapping="Wrap" />

            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Anlegen / reparieren"
                    Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                    Command="{Binding CreateSafeBootCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ Datentraeger ============ -->
      <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeader}" Text="NVME-CONTROLLER UND DATENTRÄGER" />

          <!-- Spaltenkopf -->
          <Grid Margin="10,0,10,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Datenträger" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="1" Text="Nr." Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="2" Text="Größe" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="3" Text="Treiber" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="4" Text="" Style="{StaticResource SectionHeader}" Margin="0" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Controllers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">

                  <DockPanel Margin="2,4,2,5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                               Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#0AFFFFFF" CornerRadius="4" Padding="10,7" Margin="0,0,0,3">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="70" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="120" />
                              <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding FriendlyName}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DiskNumberText}"
                                       Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding DriverFile}" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="FontFamily" Value="Consolas" />
                                  <Setter Property="FontSize" Value="12" />
                                  <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNative}" Value="True">
                                      <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="{Binding BootText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="11" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="(kein Datenträger)" Margin="10,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasDisks}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap"
                     Text="{Binding GhostText}" Visibility="{Binding GhostVisibility}" />
        </StackPanel>
      </Border>

      <!-- ============ Fusszeile ============ -->
      <DockPanel Margin="4,12,4,0">
        <Button DockPanel.Dock="Right" Content="Aktualisieren" Style="{StaticResource LinkButton}"
                Command="{Binding RefreshCommand}" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Muted}" Text="{Binding BuildText}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
            <Run Text="{Binding AdminText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LastWriteText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
